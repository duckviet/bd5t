# Local development client API URL.
# In production, leave NEXT_PUBLIC_API_BASE_URL unset so browser requests use /api/v1.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080/api/v1

# Production backend target for Next.js rewrites.
# Example: BACKEND_URL=https://api.example.com/api/v1
BACKEND_URL=

# Optional explicit browser API base URL. Usually leave unset in production.
NEXT_PUBLIC_API_BASE_URL=

# Production site URL for metadata/sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
