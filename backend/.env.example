# Server
APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bd5t?sslmode=disable
DB_MAX_CONN=10
DB_IDLE_TIMEOUT=300s
DB_MAX_LIFETIME=30m

# JWT
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookie
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limit
RATE_LIMIT_LOGIN=5
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_EVIDENCE=10

# Media / R2
R2_BUCKET=ban-do-5-tot-media
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CDN_BASE_URL=https://cdn.example.com
MAX_IMAGE_SIZE_BYTES=5242880
MAX_EVIDENCE_SIZE_BYTES=10485760